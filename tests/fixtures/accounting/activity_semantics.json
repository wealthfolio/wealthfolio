      "isExternal": false,
      "amount": "100.00",
      "expected": {
        "cashDelta": "100.00",
        "netContributionDelta": "0.00",
        "gainDelta": "100.00",
        "externalFlow": false
      }
    },
    {
      "name": "securities refund defaults to an internal correction",
      "accountType": "SECURITIES",
