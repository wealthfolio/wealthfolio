{
  "name": "wealthfolio-app",
  "private": true,
  "version": "3.12.0",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:tauri": "pnpm --filter frontend dev:tauri",
    "dev:addons": "pnpm --filter frontend dev:addons",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:web:log": "node scripts/dev-web.mjs --file-log",
    "build": "pnpm --filter frontend build",
    "build:tauri": "pnpm --filter frontend build:tauri",
    "build:types": "pnpm -r run build:types",
    "hooks:install": "git config core.hooksPath .githooks",
    "preview": "pnpm --filter frontend preview",
    "tauri": "node scripts/tauri.mjs",
    "test": "pnpm test:scripts && pnpm --filter frontend test",
    "test:scripts": "node --test scripts/tauri.test.mjs scripts/design-ratchet-direction.test.mjs scripts/design-ratchet-sign.test.mjs apps/frontend/scripts/theme-generate.test.mjs scripts/frontend-tooling.test.mjs",
    "test:watch": "pnpm --filter frontend test:watch",
    "test:ui": "pnpm --filter frontend test:ui",
    "test:coverage": "pnpm --filter frontend test:coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:net-worth": "playwright test --config playwright.net-worth.config.ts",
    "themes:generate": "pnpm --filter frontend themes:generate",
    "themes:check": "pnpm --filter frontend themes:check",
    "test:e2e:design-system": "playwright test --config playwright.design-system.config.ts",
    "test:e2e:design-system:baseline": "playwright test --config playwright.design-system.config.ts --update-snapshots=all",
    "ui:design-ratchet": "node scripts/design-ratchet.mjs",
    "test:e2e:addon-sandbox": "node scripts/run-addon-sandbox-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "lint": "oxlint --type-aware apps/frontend packages/ui packages/addon-sdk && pnpm -r lint:eslint",
    "lint:fix": "oxlint --type-aware --fix apps/frontend packages/ui packages/addon-sdk && pnpm -r lint:eslint --fix",
    "lint:quiet": "oxlint --type-aware --quiet apps/frontend packages/ui packages/addon-sdk && pnpm -r lint:eslint --quiet",
    "lint:root": "pnpm --filter frontend lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "tsc": "tsc -b",
    "type-check": "pnpm run build:types && pnpm -r type-check",
    "type-check:root": "pnpm --filter frontend type-check",
    "check": "pnpm themes:check && pnpm format:check && pnpm lint:quiet && pnpm type-check",
    "publish:sdk": "cd packages/addon-sdk && npm publish --access public",
    "publish:ui": "cd packages/ui && npm publish --access public",
    "publish:addon-dev-tools": "cd packages/addon-dev-tools && npm publish --access public",
    "addon:create": "cd packages/addon-dev-tools && node cli.js create",
    "addon:dev": "cd packages/addon-dev-tools && node dev-server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@tauri-apps/cli": "^2.12.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
