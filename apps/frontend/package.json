{
  "name": "frontend",
  "private": true,
  "version": "3.13.0",
  "type": "module",
  "homepage": "https://wealthfolio.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/wealthfolio/wealthfolio.git",
    "directory": "apps/frontend"
  },
  "bugs": {
    "url": "https://github.com/wealthfolio/wealthfolio/issues"
  },
  "scripts": {
    "dev": "cross-env BUILD_TARGET=web node scripts/dev-addon-sandbox.mjs",
    "dev:tauri": "cross-env BUILD_TARGET=tauri node scripts/dev-addon-sandbox.mjs",
    "dev:addons": "cross-env BUILD_TARGET=web node scripts/dev-addon-sandbox.mjs --mode addon-dev",
    "build:addon-sandbox-runtime": "vite build --logLevel warn --config vite.addon-sandbox.config.ts",
    "verify:addon-sandbox-runtime": "node scripts/verify-addon-sandbox-runtime.mjs",
    "build": "tsc && cross-env BUILD_TARGET=web pnpm build:addon-sandbox-runtime && cross-env BUILD_TARGET=web vite build --logLevel warn && node scripts/verify-addon-sandbox-runtime.mjs --dist --web",
    "build:tauri": "cross-env BUILD_TARGET=tauri pnpm build:addon-sandbox-runtime && cross-env BUILD_TARGET=tauri vite build --logLevel warn && node scripts/verify-addon-sandbox-runtime.mjs --dist",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "pnpm --dir ../.. exec oxlint --type-aware apps/frontend && pnpm lint:eslint",
    "lint:fix": "pnpm --dir ../.. exec oxlint --type-aware --fix apps/frontend && pnpm lint:eslint --fix",
    "lint:quiet": "pnpm --dir ../.. exec oxlint --type-aware --quiet apps/frontend && pnpm lint:eslint --quiet",
    "lint:eslint": "eslint .",
    "type-check": "tsc --noEmit",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "i18n:lint": "i18next-cli lint",
    "i18n:types": "i18next-cli types",
    "i18n:check": "node scripts/check-translations.mjs",
    "themes:generate": "node scripts/theme-generate.mjs",
    "themes:check": "node scripts/theme-generate.mjs --check"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.11.58",
    "@assistant-ui/react-markdown": "^0.11.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@internationalized/date": "^3.12.4",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-deep-link": "2.6.3",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-haptics": "~2.4.2",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-shell": "~2.6.0",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "@tauri-apps/plugin-window-state": "~2.5.0",
    "@wealthfolio/addon-sdk": "workspace:*",
    "@wealthfolio/ui": "workspace:*",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "css-tree": "^3.2.1",
    "date-fns": "^4.4.0",
    "es-module-lexer": "^3.0.4",
    "i18next": "^26.7.2",
    "i18next-resources-to-backend": "^1.2.4",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "nanoid": "^6.0.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-grid-layout": "2.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tauri-plugin-mobile-share": "^0.1.2",
    "tauri-plugin-web-auth-api": "^1.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "i18next-cli": "^1.85.1",
    "jsdom": "^28.0.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
