{
  "name": "frontend",
  "private": true,
  "version": "3.7.0",
  "type": "module",
  "homepage": "https://wealthfolio.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/wealthfolio/wealthfolio.git",
    "directory": "apps/frontend"
  },
  "bugs": {
    "url": "https://github.com/wealthfolio/wealthfolio/issues"
  },
  "scripts": {
    "dev": "cross-env BUILD_TARGET=web node scripts/dev-addon-sandbox.mjs",
    "dev:tauri": "cross-env BUILD_TARGET=tauri node scripts/dev-addon-sandbox.mjs",
    "dev:addons": "cross-env BUILD_TARGET=web node scripts/dev-addon-sandbox.mjs --mode addon-dev",
    "build:addon-sandbox-runtime": "vite build --config vite.addon-sandbox.config.ts",
    "verify:addon-sandbox-runtime": "node scripts/verify-addon-sandbox-runtime.mjs",
    "build": "tsc && cross-env BUILD_TARGET=web pnpm build:addon-sandbox-runtime && cross-env BUILD_TARGET=web vite build && node scripts/verify-addon-sandbox-runtime.mjs --dist",
    "build:tauri": "cross-env BUILD_TARGET=tauri pnpm build:addon-sandbox-runtime && cross-env BUILD_TARGET=tauri vite build && node scripts/verify-addon-sandbox-runtime.mjs --dist",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:quiet": "eslint . --quiet",
    "type-check": "tsc --noEmit",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "i18n:lint": "i18next-cli lint",
    "i18n:types": "i18next-cli types"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.11.58",
    "@assistant-ui/react-markdown": "^0.11.10",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.11.0",
    "@number-flow/react": "^0.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.4",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-haptics": "~2.3.2",
    "@tauri-apps/plugin-log": "~2.8.0",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@tauri-apps/plugin-window-state": "~2.4.1",
    "@wealthfolio/addon-sdk": "workspace:*",
    "@wealthfolio/ui": "workspace:*",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "css-tree": "^3.2.1",
    "date-fns": "^4.1.0",
    "es-module-lexer": "^2.1.0",
    "i18next": "^25.6.0",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.561.0",
    "motion": "^12.34.0",
    "nanoid": "^5.1.16",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tauri-plugin-mobile-share": "^0.1.2",
    "tauri-plugin-web-auth-api": "^1.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "i18next-cli": "^1.14.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0"
  }
}
